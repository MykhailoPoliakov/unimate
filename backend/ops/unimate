#!/bin/bash
set -e # exit if error

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$SCRIPT_DIR/../.." && pwd)"
COMPOSE="sudo docker compose --env-file backend/.env -f backend/docker-compose.yml"

cd "$REPO"

# Everything runs inside main so bash has parsed the whole script before
# "update" runs git pull, which may rewrite this very file.
main() {
case "$1" in
  start)
    echo "Starting containers..."
    $COMPOSE up -d
    ;;

  stop)
    echo "Stopping containers..."
    $COMPOSE down
    ;;

  status)
    $COMPOSE ps
    ;;

  logs)
    # Usage: unimate logs backend or unimate logs db
    $COMPOSE logs -f "${2:-backend}"
    ;;

  update)
    echo "Pulling latest code from git and rebuilding backend..."
    git pull --ff-only
    chmod +x "$SCRIPT_DIR/unimate" 2>/dev/null || true
    $COMPOSE build backend
    $COMPOSE up -d backend
    echo "Waiting for the API to become healthy..."
    for _ in $(seq 1 30); do
      if response="$(curl -fs https://api.unimate.be/health 2>/dev/null)"; then
        echo "$response"
        exit 0
      fi
      sleep 2
    done
    echo "API did not become healthy in time. Check: unimate logs backend"
    exit 1
    ;;

  list)
    echo "Accounts:"
    $COMPOSE exec backend python -m app.admin list
    ;;

  grant)
    if [ -z "$2" ]; then
      echo "Usage: unimate grant <user_id>"
      exit 1
    fi
    $COMPOSE exec backend python -m app.admin grant "$2"
    ;;

  revoke)
    if [ -z "$2" ]; then
      echo "Usage: unimate revoke <user_id>"
      exit 1
    fi
    $COMPOSE exec backend python -m app.admin revoke "$2"
    ;;

  delete)
    if [ -z "$2" ]; then
      echo "Usage: unimate delete <user_id>"
      exit 1
    fi
    $COMPOSE exec backend python -m app.admin delete "$2"
    ;;

  chuni)
    if [ -z "$2" ] || [ -z "$3" ]; then
      echo "Usage: unimate chuni <user_id> <institution>/<program>  (e.g. kdg/acs)"
      exit 1
    fi
    $COMPOSE exec backend python -m app.admin chuni "$2" "$3"
    ;;

  seed)
    echo "WARNING: this drops and recreates all tables, deleting real user data, news and votes."
    read -p "Type YES to confirm: " confirm
    if [ "$confirm" = "YES" ]; then
      $COMPOSE run --rm backend python -m app.seed
    else
      echo "Cancelled."
    fi
    ;;

  backup)
    mkdir -p "$HOME/unimate-backups"
    $COMPOSE exec -T db sh -c 'pg_dump -U "$POSTGRES_USER" "$POSTGRES_DB"' > "$HOME/unimate-backups/unimate-$(date +%F-%H%M%S).sql"
    echo "Backup saved to $HOME/unimate-backups/"
    ;;

  help)
    print_help
    ;;

  *)
    echo "Unknown command: $1"
    print_help
    exit 1
    ;;
esac
}

print_help() {
  cat <<'EOF'
Usage: unimate <command>

  start                       start containers
  stop                        stop containers
  status                      show container state
  logs [backend|db]           follow logs (default: backend)
  update                      git pull, rebuild the API, wait until healthy
  list                        list accounts
  grant <user_id>             make a user admin
  revoke <user_id>            remove admin access
  delete <user_id>            delete a user permanently
  chuni <user_id> <inst>/<program>
                              move a user to another program, e.g. kdg/acs
  seed                        destructive reset, asks for confirmation
  backup                      write a database dump to ~/unimate-backups/
  help                        show this help
EOF
}

main "$@"
exit $?
