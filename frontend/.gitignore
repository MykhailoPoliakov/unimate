# Learn more: https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Installed JavaScript packages; restore them with npm install.
node_modules/

# Expo and web build caches/output; regenerate these with Expo.
.expo/
dist/
web-build/
expo-env.d.ts

# Native project generated by a local prebuild. EAS creates its own during a cloud build.
ios/

# Local native signing credentials and generated backup files; never commit secrets.
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro bundler health-check files; generated while the bundler runs.
.metro-health-check*

# Package-manager debug logs; generated when npm, Yarn, or pnpm reports errors.
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS Finder metadata; it is unrelated to the application.
.DS_Store

# Local certificate/key files; keep private machine-specific credentials out of Git.
*.pem

# Local environment files; commit .env.example templates, not machine-specific values.
.env
.env*.local

# TypeScript incremental build cache; it is generated by the compiler.
*.tsbuildinfo

# Optional app-example directory; keep the main application source in src/.
app-example

# Do not ignore package lockfiles: commit them to keep installs reproducible.