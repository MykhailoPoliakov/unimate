{
  "expo": {
    "name": "UniMate",
    "slug": "unimate-app",
    "owner": "montely",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "unimate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "instagram",
          "fb",
          "linkedin",
          "youtube",
          "tiktok",
          "twitter",
          "discord",
          "whatsapp",
          "tg",
          "snapchat",
          "reddit",
          "slack",
          "twitch",
          "spotify",
          "msteams"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E4E1DB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1C1F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1A1C1F",
          "defaultChannel": "unimate-info"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "UniMate uses your photos when an admin adds a picture to news."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
